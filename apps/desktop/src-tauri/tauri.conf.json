{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minimal SQL",
  "version": "0.1.3",
  "identifier": "dev.pedrosad.graphite",
  "build": {
    "beforeDevCommand": "npx --no-install vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npx --no-install vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Minimal SQL",
        "width": 1280,
        "height": 800,
        "center": true,
        "visible": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 14
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "macOS": {
      "bundleName": "Minimal SQL"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4RDcwQzREOTkwMEEyNjEKUldSaG9nQ1pUUXpYR0JVREFmQ2xzR0VoM3pRVUR3L00vS2ZoR2NqMTFIL2tNME00TmhPZlczYTEK",
      "endpoints": [
        "https://github.com/PedroSad1/minimal-sql/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
