{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minimal SQL",
  "version": "0.1.2",
  "identifier": "dev.pedrosad.graphite",
  "build": {
    "beforeDevCommand": "npx --no-install vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npx --no-install vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Minimal SQL",
        "width": 1280,
        "height": 800,
        "center": true,
        "visible": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 14
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "bundleName": "Minimal SQL"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
